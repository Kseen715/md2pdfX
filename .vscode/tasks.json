{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "md2pdf: собрать PDF из текущего файла",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/src/cli.js",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "md2pdf: собрать исполняемый файл",
      "type": "npm",
      "script": "build:exe",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "md2pdf: собрать расширение",
      "type": "npm",
      "script": "build:ext",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
