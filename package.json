{
  "name": "md2pdfx",
  "displayName": "md2pdfX — Markdown to PDF",
  "description": "Export Markdown to PDF: GitHub, Obsidian, Mermaid diagrams, LaTeX formulas, page numbers",
  "version": "1.6.0",
  "publisher": "Kseen715",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kseen715/md2pdfX.git"
  },
  "homepage": "https://github.com/Kseen715/md2pdfX#readme",
  "bugs": {
    "url": "https://github.com/Kseen715/md2pdfX/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "obsidian",
    "mermaid",
    "latex",
    "katex",
    "export"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "bin": {
    "md2pdf": "src/cli.js"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "md2pdfx.export",
        "title": "%command.export%",
        "category": "md2pdfX",
        "icon": "$(file-pdf)"
      },
      {
        "command": "md2pdfx.exportWithOptions",
        "title": "%command.exportWithOptions%",
        "category": "md2pdfX",
        "icon": "$(file-pdf)"
      },
      {
        "command": "md2pdfx.exportBook",
        "title": "%command.exportBook%",
        "category": "md2pdfX",
        "icon": "$(book)"
      },
      {
        "command": "md2pdfx.exportBookWithOptions",
        "title": "%command.exportBookWithOptions%",
        "category": "md2pdfX",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "md2pdfx.export",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2pdfx.exportWithOptions",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2pdfx.exportBook",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2pdfx.exportBookWithOptions",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "md2pdfx.export",
          "when": "resourceLangId == markdown",
          "group": "navigation",
          "alt": "md2pdfx.exportWithOptions"
        }
      ],
      "editor/context": [
        {
          "command": "md2pdfx.export",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportWithOptions",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportBook",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportBookWithOptions",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        }
      ],
      "explorer/context": [
        {
          "command": "md2pdfx.export",
          "when": "resourceLangId == markdown || explorerResourceIsFolder",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportWithOptions",
          "when": "resourceLangId == markdown || explorerResourceIsFolder",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportBook",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        },
        {
          "command": "md2pdfx.exportBookWithOptions",
          "when": "resourceLangId == markdown",
          "group": "1_md2pdfx"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "md2pdfx.theme": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "gost",
            "vectorheart",
            "nord",
            "gruvbox"
          ],
          "enumItemLabels": [
            "Classic",
            "ГОСТ Р 7.0.97-2025",
            "Neo-Vectorheart",
            "Nord Light",
            "Gruvbox Light"
          ],
          "markdownEnumDescriptions": [
            "%config.theme.classic%",
            "%config.theme.gost%",
            "%config.theme.vectorheart%",
            "%config.theme.nord%",
            "%config.theme.gruvbox%"
          ],
          "scope": "resource",
          "markdownDescription": "%config.theme%"
        },
        "md2pdfx.orientation": {
          "type": "string",
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "enumItemLabels": [
            "%config.orientation.portrait%",
            "%config.orientation.landscape%"
          ],
          "scope": "resource",
          "markdownDescription": "%config.orientation%"
        },
        "md2pdfx.align": {
          "type": "string",
          "default": "justify",
          "enum": [
            "justify",
            "left",
            "center",
            "right"
          ],
          "enumItemLabels": [
            "%config.align.justify%",
            "%config.align.left%",
            "%config.align.center%",
            "%config.align.right%"
          ],
          "scope": "resource",
          "markdownDescription": "%config.align%"
        },
        "md2pdfx.sections": {
          "type": "string",
          "default": "page",
          "enum": [
            "page",
            "flow"
          ],
          "enumItemLabels": [
            "%config.sections.page%",
            "%config.sections.flow%"
          ],
          "scope": "resource",
          "markdownDescription": "%config.sections%"
        },
        "md2pdfx.watermark": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.watermark%"
        },
        "md2pdfx.chromePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.chromePath%"
        },
        "md2pdfx.extraCss": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.extraCss%"
        },
        "md2pdfx.outputDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.outputDirectory%"
        }
      }
    }
  },
  "scripts": {
    "start": "node src/cli.js",
    "examples": "node src/cli.js examples -o examples/out/",
    "build:ext": "node scripts/build.js extension",
    "build:exe": "node scripts/build.js exe",
    "build:gui": "node scripts/build.js gui",
    "package:ext": "vsce package --no-dependencies -o dist/",
    "vscode:prepublish": "npm run build:ext",
    "gui": "electron src/gui/main.js",
    "icons": "electron scripts/icons.mjs --ozone-platform=headless"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "mermaid": "^12.0.0",
    "puppeteer-core": "^25.11.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-armenian": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "^5.3.0",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@vscode/vsce": "^4.0.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2"
  }
}
